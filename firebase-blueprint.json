{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "Corps Member profile details and service status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "full_name": { "type": "string" },
        "phone": { "type": "string" },
        "state_code": { "type": "string" },
        "state_of_deployment": { "type": "string" },
        "lga": { "type": "string" },
        "batch_stream": { "type": "string" },
        "current_phase": { "type": "string" },
        "ppa_name": { "type": "string" },
        "cds_group": { "type": "string" },
        "is_admin": { "type": "boolean" },
        "swearing_in_date": { "type": "string" },
        "pop_date": { "type": "string" }
      },
      "required": ["id", "full_name"]
    },
    "UserFeedback": {
      "title": "UserFeedback",
      "description": "User feedback and issue reports submitted by corps members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "user_name": { "type": "string" },
        "user_phone": { "type": "string" },
        "category": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "user_id", "message", "status"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "Customizable NYSC service events and deadlines for Google Calendar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "location": { "type": "string" },
        "eventType": { "type": "string" },
        "recurrenceRule": { "type": "string" }
      },
      "required": ["id", "title", "startDate"]
    },
    "HousingListing": {
      "title": "HousingListing",
      "description": "Corper lodges, private rentals, flat shares, and roommate listings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "lodge_type": { "type": "string" },
        "category": { "type": "string" },
        "state": { "type": "string" },
        "lga": { "type": "string" },
        "address": { "type": "string" },
        "cost_description": { "type": "string" },
        "caretaker_name": { "type": "string" },
        "caretaker_phone": { "type": "string" },
        "available_spaces": { "type": "number" },
        "gender_preference": { "type": "string" }
      },
      "required": ["id", "name", "cost_description"]
    },
    "EmergencyContact": {
      "title": "EmergencyContact",
      "description": "State-specific emergency desk and inspectorate contact records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "contact_name": { "type": "string" },
        "role_title": { "type": "string" },
        "phone_number": { "type": "string" },
        "state": { "type": "string" },
        "lga": { "type": "string" }
      },
      "required": ["id", "contact_name", "phone_number"]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": "Profile",
      "description": "User profile collection partitioned by user ID"
    },
    "/user_feedback/{feedbackId}": {
      "schema": "UserFeedback",
      "description": "Feedback inbox collection for admin triage and response"
    },
    "/calendar_events/{eventId}": {
      "schema": "CalendarEvent",
      "description": "Calendar events synced with Google Calendar"
    },
    "/housing_listings/{listingId}": {
      "schema": "HousingListing",
      "description": "Lodges, private apartments, and roommate offerings"
    },
    "/emergency_contacts/{contactId}": {
      "schema": "EmergencyContact",
      "description": "Individual profile emergency contacts and state inspectorate lines"
    }
  }
}
